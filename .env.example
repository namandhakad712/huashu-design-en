# Doubao TTS (Volcengine openspeech, v3 streaming API)
# Apply: https://console.volcengine.com/speech
# Auth, pick one: DOUBAO_TTS_API_KEY (new-style API key), or DOUBAO_APP_ID + DOUBAO_ACCESS_KEY (console pair)
#DOUBAO_TTS_API_KEY=your_api_key_here
#DOUBAO_APP_ID=your_app_id_here
#DOUBAO_ACCESS_KEY=your_access_token_here
DOUBAO_TTS_VOICE_ID=your_voice_id_here
# Optional: auto-inferred from the voice by default (S_ cloned voices -> seed-icl-2.0, uranus -> seed-tts-2.0, other official voices -> seed-tts-1.0)
#DOUBAO_TTS_RESOURCE_ID=
# Optional: defaults to https://openspeech.bytedance.com/api/v3/tts/unidirectional
#DOUBAO_TTS_ENDPOINT=

# AI video review (optional cloud capability, scripts/cloud/ai-review-video.py)
# Volcengine Ark API key, apply at: https://console.volcengine.com/ark
ARK_API_KEY=your_ark_api_key_here
